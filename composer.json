{
    "name": "mikeleeman/libxlsxwriter-wrapper-ly",
    "description": "Static libxlsxwriter-backed NDJSON-to-xlsx binary, installed automatically via a Composer plugin.",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": [
        "xlsx",
        "excel",
        "libxlsxwriter",
        "spreadsheet"
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Ly\\XlsxWriterWrapper\\": "src/"
        }
    },
    "bin": [
        "bin/xlsx_writer"
    ],
    "extra": {
        "class": "Ly\\XlsxWriterWrapper\\Plugin",
        "xlsx-writer-binary-version": "v1.0.0"
    }
}
